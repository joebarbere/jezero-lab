<?xml version="1.0"?>
<!-- Gazebo Classic test world: the ground is a plane tilted 10 degrees about y
     (downhill toward -x). Used to show whether wheel friction reaches the sim. -->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <model name="slope">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>-0.173648 0 0.984808</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>100</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>-0.173648 0 0.984808</normal><size>200 200</size></plane></geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
