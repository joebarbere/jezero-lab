<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osr_gz</name>
  <version>0.1.0</version>
  <description>
    NASA-JPL Open Source Rover simulation for Gazebo Classic (Humble) and Gazebo
    Harmonic (Jazzy), with optional primitive collision geometry. Derived from
    osr-rover-code/ROS/osr_gazebo.
  </description>
  <maintainer email="joe.barbere@gmail.com">Joe Barbere</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>osr_bringup</exec_depend>
  <exec_depend>osr_control</exec_depend>
  <exec_depend>osr_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Gazebo Classic: Humble only -->
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_ros</exec_depend>
  <exec_depend condition="$ROS_DISTRO == humble">gazebo_ros2_control</exec_depend>

  <!-- Gazebo Harmonic: Jazzy and later -->
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_bridge</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">ros_gz_sim</exec_depend>
  <exec_depend condition="$ROS_DISTRO != humble">gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
