<?xml version="1.0"?>
<!-- Gazebo Classic empty world. sim.launch.py sets the physics step and
     real-time throttling (realtime:=, step:=) in a temp copy. -->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>
  </world>
</sdf>
